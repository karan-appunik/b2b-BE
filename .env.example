# backend-api. Copy to .env and fill in. Never commit .env.

PORT=5000
MONGODB_URI=mongodb://localhost:27017/sparklayer

SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_API_VERSION=

# Login tokens for the merchant panel
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Shared secret with admin-frontend (BACKEND_INTERNAL_API_KEY there must be the same value)
INTERNAL_API_KEY=

# Where the other apps live. ADMIN_FRONTEND_URL is the address shopify app dev prints (or the live URL).
ADMIN_FRONTEND_URL=
MERCHANT_PANEL_URL=http://localhost:3001

# Email (password reset, invites)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional (sales agents)
# MFA_ENCRYPTION_KEY=
# MFA_SESSION_HOURS=
# AGENT_MFA_DEFAULT=
# AGENT_CONTEXT_TTL_MINUTES=
# AGENT_EVENTS_WEBHOOK_URL=
# AGENT_EVENTS_WEBHOOK_SECRET=
# ANALYTICS_PSEUDONYM_KEY=
